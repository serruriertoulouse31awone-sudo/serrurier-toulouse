# serruriertoulouse.fr sur l'hébergement OVH (Apache) : mêmes adresses et mêmes réponses que chez Vercel
# (relevées le 02/10/2026), adresse principale en www, PHP seulement dans /avis/.
# Les redirections ne visent que le vrai domaine : l'adresse technique d'OVH (serrurk.cluster100.hosting.ovh.net)
# sert le site tel quel, ce qui permet de tout tester avant de basculer le domaine.

Options -Indexes
DirectoryIndex index.html
# /serrurier-balma ne doit pas être redirigé vers /serrurier-balma/ (Vercel répond aux deux sans redirection)
DirectorySlash Off
AddDefaultCharset utf-8

RewriteEngine On

# serruriertoulouse.fr (http ou https) -> https://www.serruriertoulouse.fr
RewriteCond %{HTTP_HOST} ^serruriertoulouse\.fr$ [NC]
RewriteRule ^ https://www.serruriertoulouse.fr%{REQUEST_URI} [R=301,L]

# http://www.serruriertoulouse.fr -> https (méthode recommandée par OVH sur ses hébergements mutualisés)
RewriteCond %{HTTP_HOST} ^www\.serruriertoulouse\.fr$ [NC]
RewriteCond %{SERVER_PORT} 80
RewriteRule ^ https://www.serruriertoulouse.fr%{REQUEST_URI} [R=301,L]

# /serrurier-balma et /serrurier-balma/ -> serrurier-balma/index.html, sans redirection
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_FILENAME}/index.html -f
RewriteRule ^(.+?)/?$ $1/index.html [L]

# Aucun fichier caché servi (.htaccess, .git...)
<FilesMatch "^\.">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always setifempty Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Strict-Transport-Security "max-age=63072000" "expr=%{SERVER_PORT} == 443"
  # Fichiers versionnés d'Astro (le nom change à chaque version) : un an en cache, comme chez Vercel.
  # Le reste est revalidé à chaque visite ; /avis/ règle lui-même son cache.
  <If "%{REQUEST_URI} =~ m#^/_astro/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  <ElseIf "%{REQUEST_URI} !~ m#^/avis/#">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </ElseIf>
</IfModule>

# L'adresse technique d'OVH (essais avant la bascule du domaine) ne doit jamais être indexée
<IfModule mod_headers.c>
  <If "%{HTTP_HOST} =~ /\.hosting\.ovh\.net$/">
    Header always set X-Robots-Tag "noindex, nofollow"
  </If>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json application/xml image/svg+xml
</IfModule>

<IfModule mod_mime.c>
  AddType video/mp4 .mp4
  AddType image/webp .webp
  AddType image/svg+xml .svg
</IfModule>
