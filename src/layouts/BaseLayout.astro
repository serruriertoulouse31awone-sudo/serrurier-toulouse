---
import "@/styles/globals.css";
import type { PageMetadata } from "@/utils/seo";

type Props = {
  metadata: PageMetadata;
};

const { metadata } = Astro.props as Props;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#5020b8" />
    <meta name="format-detection" content="telephone=no" />
    <title>{metadata.title}</title>
    <meta name="description" content={metadata.description} />
    <meta
      name="keywords"
      content="serrurier toulouse, serrurier toulouse 24h 24, ouverture de porte toulouse, dépannage serrure toulouse, urgence serrurier toulouse, serrurier Balma, serrurier Blagnac, serrurier Colomiers"
    />
    <meta name="author" content="Serrurier Toulouse" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={metadata.canonical} />
    <link rel="icon" href="/images/serrurier-toulouse.svg" />
    <link
      rel="preload"
      as="image"
      href="/video/vignette-1067.webp"
      imagesrcset="/video/vignette-640.webp 640w, /video/vignette-1067.webp 1067w, /video/vignette-1600.webp 1600w"
      imagesizes="(max-width: 991px) 90vw, 56vw"
      fetchpriority="high"
    />
    <link rel="preload" href="/fonts/dm-sans-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/bebas-neue-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="/fonts/polices.css" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={metadata.canonical} />
    <meta property="og:title" content={metadata.title} />
    <meta property="og:description" content={metadata.description} />
    <meta property="og:image" content={metadata.ogImage} />
    <meta property="og:locale" content="fr_FR" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={metadata.title} />
    <meta name="twitter:description" content={metadata.description} />
    <meta name="twitter:image" content={metadata.ogImage} />
  </head>
  <body>
    <slot />
  </body>
</html>
